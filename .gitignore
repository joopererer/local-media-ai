# Rust / Cargo
/target/
**/*.rs.bk

# Local runtimes, models and imported libraries (never committed)
/llama/
/runtime/
*.lib
*.dll
*.so
*.dylib
*.zip

# Model weights are never committed; only the download manifests under
# models/ are (they carry the pinned sha256 of every file).
/models/*
!/models/*.json

# Evaluation runs (regenerable; only the public baseline is committed)
eval/history/
eval/golden/
eval/private/

# Python helpers
__pycache__/
*.pyc
.venv/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
